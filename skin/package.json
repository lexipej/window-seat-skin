{
  "name": "window-seat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "node apps/preview/deploy.mjs",
    "deploy:vercel": "bunx vercel@64 build && bunx vercel@64 deploy --prebuilt",
    "deploy:netlify": "bunx netlify-cli@27 deploy --build",
    "deploy:cloudflare": "bun run build && bunx wrangler@4 pages deploy dist --project-name window-seat"
  },
  "dependencies": {
    "@videojs/html": "10.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.180.0",
    "@videojs/mux-video": "10.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "postcss-selector-parser": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
